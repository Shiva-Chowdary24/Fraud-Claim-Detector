import React, { useState, useEffect } from "react";
import { useLocation, useNavigate } from "react-router-dom";
import API from "../services/api";
import confetti from "canvas-confetti"; // ✅ Import for the party blast
import { ShieldCheck, X, Calculator, Loader2, Sparkles, CheckCircle } from "lucide-react";

function ClaimAmountPage() {
  const location = useLocation();
  const navigate = useNavigate();
  
  // Handshake from ClaimAmount.js
  const [view, setView] = useState(location.state?.autoApproved ? "approved" : "initial"); 
  const [result, setResult] = useState(null);
  const [loading, setLoading] = useState(false);

  // Security Gate: If someone tries to access this page without approval, send them back
  useEffect(() => {
    if (!location.state?.autoApproved && view !== "prediction") {
      navigate("/customer/claim-amount");
    }
  }, [location, navigate, view]);

  /**
   * ✅ Updated Endpoint Logic
   */
  const handlePredict = async () => {
    setLoading(true);
    try {
      // 1. Match the new backend route we created
      const payload = {
        policy_id: location.state?.policyId,
        customer_id: localStorage.getItem("customer_id"),
        claim_amount: parseFloat(location.state?.claimAmount || 0)
      };

      const res = await API.post("/calculate-payout", payload); 
      
      // 2. Set Result and trigger Success State
      setResult(res.data.amount);
      setView("prediction");

      // ✅ 3. TRIGGER PARTY BLAST (Confetti)
      triggerConfetti();

      // ✅ 4. AUTOMATIC REDIRECT AFTER 6 SECONDS
      // This gives the user time to see the congratulations before moving
      setTimeout(() => {
        navigate("/customer/claim-policies");
      }, 6000);

    } catch (err) {
      console.error("Valuation failed", err);
    } finally {
      setLoading(false);
    }
  };

  const triggerConfetti = () => {
    confetti({
      particleCount: 150,
      spread: 70,
      origin: { y: 0.6 },
      colors: ["#3b82f6", "#10b981", "#ffffff"]
    });
  };

  return (
    <div className="min-h-screen bg-[#0f172a] text-slate-200 p-6 font-sans flex items-center justify-center">
      <div className="w-full max-w-md bg-[#1e293b] border border-slate-700 rounded-3xl shadow-2xl p-8 relative overflow-hidden">
        
        <div className="absolute -top-24 -left-24 w-48 h-48 bg-blue-500/10 blur-3xl rounded-full"></div>

        {/* --- VIEW: AUTO-APPROVED --- */}
        {view === "approved" && (
          <div className="text-center space-y-6 animate-in fade-in zoom-in duration-500">
            <div className="flex justify-center">
              <div className="bg-emerald-500/10 p-4 rounded-2xl border border-emerald-500/20">
                <ShieldCheck size={48} className="text-emerald-400" />
              </div>
            </div>
            
            <div className="space-y-2 text-center">
              <h2 className="text-2xl font-bold text-white tracking-tight">Claim Auto-Approved</h2>
              <p className="text-sm text-slate-400 px-4">
                Our AI engine found no irregularities. You are eligible for an immediate payout estimation.
              </p>
            </div>

            <div className="space-y-3 pt-4">
              <button 
                onClick={handlePredict} 
                className="w-full bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-xl font-bold flex justify-center items-center gap-2 transition-all active:scale-95 shadow-lg shadow-blue-900/20"
              >
                {loading ? <Loader2 className="animate-spin" /> : (
                  <>
                    <Sparkles size={18} />
                    Predict Payout Amount
                  </>
                )}
              </button>
            </div>
          </div>
        )}

        {/* --- VIEW: CONGRATULATIONS & PREDICTION RESULT --- */}
        {view === "prediction" && (
          <div className="text-center space-y-6 animate-in slide-in-from-bottom-8 duration-500">
            <div className="flex justify-center">
               <CheckCircle size={60} className="text-emerald-400 animate-bounce" />
            </div>

            <div className="space-y-2">
               <h1 className="text-3xl font-black text-white uppercase tracking-tighter">Congratulations!</h1>
               <p className="text-emerald-400 font-bold">The claimable amount is up to:</p>
            </div>

            <div className="bg-gradient-to-b from-slate-800 to-slate-900 border border-slate-700 rounded-2xl py-8 shadow-inner">
              <h3 className="text-5xl font-black text-white tracking-tighter">
                <span className="text-blue-500">$</span>{result?.toLocaleString()}
              </h3>
            </div>

            <div className="pt-4 space-y-3">
              <p className="text-[10px] text-slate-500 uppercase tracking-widest animate-pulse">
                Redirecting to active policies in 5s...
              </p>
              <button 
                onClick={() => navigate("/customer/claim-policies")} 
                className="w-full text-xs text-blue-400 hover:underline font-bold"
              >
                Skip to Policy List
              </button>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}

export default ClaimAmountPage;
